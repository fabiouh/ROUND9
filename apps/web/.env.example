# Auth0 (Regular Web Application)
AUTH0_DOMAIN=YOUR_TENANT.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Must match the API identifier configured in Auth0 and AUTH0_AUDIENCE in apps/api
AUTH0_AUDIENCE=https://api.round9.app

# ROUND9 API (server-side only; the browser talks to /api/r9 which proxies with the user's token)
API_URL=http://localhost:4000/api/v1
